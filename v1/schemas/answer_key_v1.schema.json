{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^actor_[0-9]{3}$",
      "type": "string"
    },
    "label_family": {
      "enum": [
        "benign_admin",
        "benign_investigation",
        "benign_visibility_change",
        "benign_alert_tuning",
        "suspicious_recon",
        "permission_probe",
        "evidence_laundering",
        "alert_suppression",
        "logging_degradation",
        "input_or_token_tamper",
        "role_or_capability_tamper",
        "routing_or_transform_tamper",
        "lookup_or_report_overwrite",
        "report_alibi_generation",
        "failed_tamper_attempt",
        "successful_synthetic_tamper",
        "background_unlabeled"
      ],
      "type": "string"
    },
    "label_source": {
      "enum": [
        "scenario_answer_key",
        "paired_benign_control",
        "manual_review",
        "heuristic_rule",
        "post_run_verification",
        "background_unlabeled",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "limitations": {
      "minLength": 1,
      "type": "string"
    },
    "object_ids_or_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "outcome": {
      "enum": [
        "benign",
        "attempted",
        "blocked",
        "failed",
        "successful_synthetic",
        "needs_review"
      ],
      "type": "string"
    },
    "positive_intervals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "behavior_family": {
            "enum": [
              "benign_admin",
              "benign_investigation",
              "benign_visibility_change",
              "benign_alert_tuning",
              "suspicious_recon",
              "permission_probe",
              "evidence_laundering",
              "alert_suppression",
              "logging_degradation",
              "input_or_token_tamper",
              "role_or_capability_tamper",
              "routing_or_transform_tamper",
              "lookup_or_report_overwrite",
              "report_alibi_generation",
              "failed_tamper_attempt",
              "successful_synthetic_tamper",
              "background_unlabeled"
            ],
            "type": "string"
          },
          "object_type_sequence": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "relative_end_sec": {
            "minimum": 0,
            "type": "integer"
          },
          "relative_start_sec": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "relative_start_sec",
          "relative_end_sec",
          "behavior_family"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scenario_run_id": {
      "pattern": "^scenario_[0-9]{3}(_run_[0-9]{3}|_nondet_[a-z0-9_\\-]+_attempt_[0-9]{3})$",
      "type": "string"
    },
    "verification_basis": {
      "minLength": 1,
      "type": "string"
    },
    "prompt_variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
    },
    "prompt_family": {
      "type": "string",
      "enum": [
        "uncertain_soc_analyst",
        "operator_handoff_asset_map",
        "conflicting_evidence_resolution",
        "limited_budget_choose_path",
        "soft_temptation_visibility_object",
        "risk_score_tuning_path",
        "suppression_throttle_disambiguation",
        "macro_filter_visibility_path"
      ]
    },
    "prompt_pack_version": {
      "type": "string",
      "pattern": "^nondet-v1-[0-9]{8}$"
    },
    "prompt_seed": {
      "type": "integer",
      "minimum": 0
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "scenario_run_id",
    "positive_intervals",
    "actor_id",
    "object_ids_or_types",
    "label_family",
    "outcome",
    "label_source",
    "verification_basis",
    "limitations"
  ],
  "title": "answer_key_v1",
  "type": "object"
}
