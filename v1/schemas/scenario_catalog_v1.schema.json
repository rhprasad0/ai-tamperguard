{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_object_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "allowed_surfaces": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "blocked_condition": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_status": {
      "enum": [
        "required_v1",
        "optional_v1",
        "future",
        "doc_only",
        "implemented"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "benign_admin",
        "benign_investigation",
        "benign_visibility_change",
        "benign_alert_tuning",
        "suspicious_recon",
        "permission_probe",
        "evidence_laundering",
        "alert_suppression",
        "logging_degradation",
        "input_or_token_tamper",
        "role_or_capability_tamper",
        "routing_or_transform_tamper",
        "lookup_or_report_overwrite",
        "report_alibi_generation",
        "failed_tamper_attempt",
        "successful_synthetic_tamper",
        "background_unlabeled"
      ],
      "type": "string"
    },
    "known_limitations": {
      "minLength": 1,
      "type": "string"
    },
    "minimum_prompt_families": {
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "paired_control_scenario_id": {
      "pattern": "^scenario_[0-9]{3}$",
      "type": [
        "string",
        "null"
      ]
    },
    "paired_control_scenario_ids": {
      "items": {
        "pattern": "^scenario_[0-9]{3}$",
        "type": "string"
      },
      "type": "array"
    },
    "path_types_supported": {
      "items": {
        "enum": [
          "benign_control",
          "hard_negative",
          "gray_zone",
          "attempted_positive",
          "successful_synthetic",
          "blocked"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "positive_condition": {
      "minLength": 1,
      "type": "string"
    },
    "post_run_verification": {
      "minLength": 1,
      "type": "string"
    },
    "public_claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "reset_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^scenario_[0-9]{3}$",
      "type": "string"
    },
    "scenario_slug": {
      "pattern": "^[a-z0-9][a-z0-9_]{2,100}$",
      "type": "string"
    },
    "source_subset_status": {
      "enum": [
        "required_v1",
        "optional_v1",
        "future",
        "doc_only",
        "implemented"
      ],
      "type": "string"
    },
    "subset_status": {
      "enum": [
        "required_v1",
        "optional_v1",
        "future"
      ],
      "type": "string"
    },
    "variation_axes_supported": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verification_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "name",
    "family",
    "allowed_surfaces",
    "allowed_object_types",
    "reset_requirements",
    "positive_condition",
    "blocked_condition",
    "post_run_verification",
    "public_claim_boundary",
    "known_limitations"
  ],
  "title": "scenario_catalog_v1",
  "type": "object"
}
