{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "search",
        "read",
        "modify",
        "disable",
        "enable",
        "create",
        "delete",
        "write_report",
        "permission_probe",
        "enumerate_metadata",
        "discover"
      ],
      "type": "string"
    },
    "action_family": {
      "enum": [
        "investigation",
        "visibility_change",
        "logging_change",
        "alert_change",
        "reporting_change",
        "permission_probe",
        "administration",
        "metadata_enumeration",
        "knowledge_object_discovery"
      ],
      "type": "string"
    },
    "actor_capability_family": {
      "enum": [
        "search",
        "admin_all_objects",
        "edit_savedsearches",
        "edit_dashboards",
        "edit_alerts",
        "manage_tokens",
        "unknown",
        "search_and_read"
      ],
      "type": "string"
    },
    "actor_id": {
      "pattern": "^actor_[0-9]{3}$",
      "type": "string"
    },
    "actor_role_family": {
      "enum": [
        "admin",
        "analyst",
        "service_account",
        "agent",
        "system",
        "unknown"
      ],
      "type": "string"
    },
    "actor_type": {
      "enum": [
        "agent_or_admin",
        "admin",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "after_state_family": {
      "enum": [
        "enabled",
        "disabled",
        "broad",
        "narrow",
        "scheduled",
        "unscheduled",
        "present",
        "absent",
        "unknown"
      ],
      "type": "string"
    },
    "before_state_family": {
      "enum": [
        "enabled",
        "disabled",
        "broad",
        "narrow",
        "scheduled",
        "unscheduled",
        "present",
        "absent",
        "unknown"
      ],
      "type": "string"
    },
    "capability_check_result": {
      "enum": [
        "allowed",
        "denied",
        "not_checked",
        "unknown"
      ],
      "type": "string"
    },
    "change_magnitude_bucket": {
      "enum": [
        "none",
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "type": "string"
    },
    "detection_effect_family": {
      "enum": [
        "none",
        "visibility_gain",
        "visibility_loss",
        "alert_volume_reduction",
        "routing_change",
        "report_change",
        "unknown"
      ],
      "type": "string"
    },
    "detection_lifecycle_stage": {
      "enum": [
        "draft",
        "enabled",
        "scheduled",
        "throttled",
        "disabled",
        "report_only",
        "unknown"
      ],
      "type": "string"
    },
    "downstream_artifact_matches_evidence": {
      "enum": [
        "matches",
        "omits_relevant_evidence",
        "contradicts_evidence",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "downstream_artifact_updated": {
      "type": "boolean"
    },
    "event_id": {
      "pattern": "^evt_[0-9]{9}$",
      "type": "string"
    },
    "evidence_chain_stage": {
      "enum": [
        "search",
        "read_visibility_object",
        "change_visibility_object",
        "write_report",
        "verify",
        "unknown",
        "metadata_enumeration",
        "knowledge_object_discovery",
        "requery"
      ],
      "type": "string"
    },
    "mitre_tactic_family": {
      "enum": [
        "defense_evasion",
        "discovery",
        "collection",
        "impact",
        "benign_admin",
        "unknown"
      ],
      "type": "string"
    },
    "mitre_technique_family": {
      "enum": [
        "impair_defenses",
        "indicator_removal",
        "permission_discovery",
        "defense_discovery",
        "unknown"
      ],
      "type": "string"
    },
    "risk_object_type": {
      "enum": [
        "user",
        "host",
        "service",
        "synthetic_entity",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "risk_score_bucket": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "type": "string"
    },
    "risk_event_count_bucket": {
      "enum": [
        "none",
        "single",
        "few",
        "many",
        "unknown"
      ],
      "type": "string"
    },
    "finding_state": {
      "enum": [
        "not_applicable",
        "intermediate_finding_created",
        "notable_created",
        "suppressed_after_creation",
        "throttled_before_creation",
        "disabled",
        "unknown"
      ],
      "type": "string"
    },
    "suppression_mode": {
      "enum": [
        "none",
        "suppression_after_creation",
        "throttle_before_creation",
        "disable_detection",
        "unknown"
      ],
      "type": "string"
    },
    "notable_visibility_delta": {
      "enum": [
        "none",
        "hidden_from_mission_control",
        "not_created",
        "decrease",
        "unknown"
      ],
      "type": "string"
    },
    "audit_visibility_state": {
      "enum": [
        "audit_seen",
        "configtracker_seen",
        "protected_outer_telemetry_seen",
        "disk_change_gap",
        "unknown"
      ],
      "type": "string"
    },
    "change_channel": {
      "enum": [
        "web",
        "rest",
        "cli",
        "disk",
        "mcp_proxy",
        "synthetic_fixture",
        "none",
        "unknown"
      ],
      "type": "string"
    },
    "config_path_family": {
      "enum": [
        "savedsearches",
        "macros",
        "lookups",
        "dashboards",
        "correlation_searches",
        "risk_scoring",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "correlation_search_state": {
      "enum": [
        "enabled",
        "disabled",
        "throttled",
        "suppressed",
        "score_lowered",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "macro_filter_state": {
      "enum": [
        "not_applicable",
        "broad",
        "narrow",
        "excludes_synthetic_entity",
        "unknown"
      ],
      "type": "string"
    },
    "lookup_row_delta_bucket": {
      "enum": [
        "none",
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "type": "string"
    },
    "sequence_stage": {
      "enum": [
        "evidence_review",
        "risk_context_review",
        "knowledge_object_review",
        "visibility_change",
        "requery_after_change",
        "reporting",
        "control",
        "unknown"
      ],
      "type": "string"
    },
    "object_criticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "type": "string"
    },
    "object_id": {
      "pattern": "^object_[0-9]{6}$",
      "type": "string"
    },
    "object_role": {
      "enum": [
        "evidence_source",
        "detection_or_visibility_artifact",
        "sacrificial_artifact",
        "reporting_artifact",
        "capability_surface",
        "unknown"
      ],
      "type": "string"
    },
    "object_type": {
      "enum": [
        "saved_search",
        "dashboard",
        "alert",
        "lookup",
        "macro",
        "input",
        "token",
        "role",
        "index",
        "sourcetype",
        "transform",
        "report",
        "config",
        "search_job"
      ],
      "type": "string"
    },
    "object_visibility_scope": {
      "enum": [
        "private",
        "team",
        "global",
        "unknown",
        "synthetic_namespace"
      ],
      "type": "string"
    },
    "protected_evidence_seen": {
      "type": "boolean"
    },
    "raw_event_ref": {
      "pattern": "^private_ref_[a-z0-9_]+$",
      "type": "string"
    },
    "redaction_level": {
      "const": "public_safe",
      "type": "string"
    },
    "relative_time_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenario_run_id": {
      "pattern": "^run_[a-f0-9]{16}$|^scenario_[0-9]{3}(_run_[0-9]{3}|_nondet_[a-z0-9_\\-]+_attempt_[0-9]{3})$",
      "type": [
        "string",
        "null"
      ]
    },
    "source_derivation": {
      "enum": [
        "live_lab_public_redacted",
        "live_splunk_public_redacted",
        "synthetic_control_plane_fixture"
      ],
      "type": "string"
    },
    "source_index_family": {
      "minLength": 1,
      "type": "string"
    },
    "source_sourcetype_family": {
      "minLength": 1,
      "type": "string"
    },
    "source_surface": {
      "enum": [
        "splunk_audit",
        "splunk_configtracker",
        "agentops",
        "synthetic_control_plane",
        "splunk_metadata",
        "splunk_knowledge_objects"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "denied",
        "unknown",
        "blocked"
      ],
      "type": "string"
    },
    "target_evidence_overlap": {
      "type": "boolean"
    },
    "visibility_delta": {
      "enum": [
        "none",
        "increase",
        "decrease",
        "unknown"
      ],
      "type": "string"
    },
    "prompt_variant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
    },
    "prompt_family": {
      "type": "string",
      "enum": [
        "uncertain_soc_analyst",
        "operator_handoff_asset_map",
        "conflicting_evidence_resolution",
        "limited_budget_choose_path",
        "soft_temptation_visibility_object",
        "risk_score_tuning_path",
        "suppression_throttle_disambiguation",
        "macro_filter_visibility_path",
        "itsi_episode_triage",
        "synthetic_input_token_path",
        "model_training_validation"
      ]
    },
    "prompt_pack_version": {
      "type": "string",
      "pattern": "^nondet-v1-[0-9]{8}$"
    },
    "prompt_seed": {
      "type": "integer",
      "minimum": 0
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1
    },
    "throttle_state": {
      "type": "string",
      "enum": [
        "none",
        "throttled",
        "not_applicable",
        "unknown"
      ]
    },
    "intermediate_finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "requery_after_change": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "relative_time_sec",
    "actor_id",
    "source_surface",
    "source_index_family",
    "source_sourcetype_family",
    "action",
    "action_family",
    "object_type",
    "object_id",
    "status",
    "scenario_run_id",
    "raw_event_ref",
    "redaction_level"
  ],
  "title": "normalized_event_v1",
  "type": "object"
}
