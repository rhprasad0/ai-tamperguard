{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "search",
        "read",
        "modify",
        "disable",
        "enable",
        "create",
        "delete",
        "write_report",
        "permission_probe"
      ],
      "type": "string"
    },
    "action_family": {
      "enum": [
        "investigation",
        "visibility_change",
        "logging_change",
        "alert_change",
        "reporting_change",
        "permission_probe",
        "administration"
      ],
      "type": "string"
    },
    "actor_capability_family": {
      "enum": [
        "search",
        "admin_all_objects",
        "edit_savedsearches",
        "edit_dashboards",
        "edit_alerts",
        "manage_tokens",
        "unknown"
      ],
      "type": "string"
    },
    "actor_id": {
      "pattern": "^actor_[0-9]{3}$",
      "type": "string"
    },
    "actor_role_family": {
      "enum": [
        "admin",
        "analyst",
        "service_account",
        "agent",
        "system",
        "unknown"
      ],
      "type": "string"
    },
    "actor_type": {
      "enum": [
        "agent_or_admin",
        "admin",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "after_state_family": {
      "enum": [
        "enabled",
        "disabled",
        "broad",
        "narrow",
        "scheduled",
        "unscheduled",
        "present",
        "absent",
        "unknown"
      ],
      "type": "string"
    },
    "before_state_family": {
      "enum": [
        "enabled",
        "disabled",
        "broad",
        "narrow",
        "scheduled",
        "unscheduled",
        "present",
        "absent",
        "unknown"
      ],
      "type": "string"
    },
    "capability_check_result": {
      "enum": [
        "allowed",
        "denied",
        "not_checked",
        "unknown"
      ],
      "type": "string"
    },
    "change_magnitude_bucket": {
      "enum": [
        "none",
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "type": "string"
    },
    "detection_effect_family": {
      "enum": [
        "none",
        "visibility_gain",
        "visibility_loss",
        "alert_volume_reduction",
        "routing_change",
        "report_change",
        "unknown"
      ],
      "type": "string"
    },
    "detection_lifecycle_stage": {
      "enum": [
        "draft",
        "enabled",
        "scheduled",
        "throttled",
        "disabled",
        "report_only",
        "unknown"
      ],
      "type": "string"
    },
    "downstream_artifact_matches_evidence": {
      "enum": [
        "matches",
        "omits_relevant_evidence",
        "contradicts_evidence",
        "not_applicable",
        "unknown"
      ],
      "type": "string"
    },
    "downstream_artifact_updated": {
      "type": "boolean"
    },
    "event_id": {
      "pattern": "^evt_[0-9]{9}$",
      "type": "string"
    },
    "evidence_chain_stage": {
      "enum": [
        "search",
        "read_visibility_object",
        "change_visibility_object",
        "write_report",
        "verify",
        "unknown"
      ],
      "type": "string"
    },
    "object_criticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "type": "string"
    },
    "object_id": {
      "pattern": "^object_[0-9]{6}$",
      "type": "string"
    },
    "object_role": {
      "enum": [
        "evidence_source",
        "detection_or_visibility_artifact",
        "sacrificial_artifact",
        "reporting_artifact",
        "capability_surface",
        "unknown"
      ],
      "type": "string"
    },
    "object_type": {
      "enum": [
        "saved_search",
        "dashboard",
        "alert",
        "lookup",
        "input",
        "token",
        "role",
        "index",
        "sourcetype",
        "transform",
        "report",
        "config",
        "search_job"
      ],
      "type": "string"
    },
    "object_visibility_scope": {
      "enum": [
        "private",
        "team",
        "global",
        "unknown"
      ],
      "type": "string"
    },
    "protected_evidence_seen": {
      "type": "boolean"
    },
    "raw_event_ref": {
      "pattern": "^private_ref_[a-z0-9_]+$",
      "type": "string"
    },
    "redaction_level": {
      "const": "public_safe",
      "type": "string"
    },
    "relative_time_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenario_run_id": {
      "pattern": "^scenario_[0-9]{3}_run_[0-9]{3}$",
      "type": [
        "string",
        "null"
      ]
    },
    "source_derivation": {
      "enum": [
        "live_lab_public_redacted",
        "synthetic_control_plane_fixture"
      ],
      "type": "string"
    },
    "source_index_family": {
      "minLength": 1,
      "type": "string"
    },
    "source_sourcetype_family": {
      "minLength": 1,
      "type": "string"
    },
    "source_surface": {
      "enum": [
        "splunk_audit",
        "splunk_configtracker",
        "agentops",
        "synthetic_control_plane"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "denied",
        "unknown"
      ],
      "type": "string"
    },
    "target_evidence_overlap": {
      "type": "boolean"
    },
    "visibility_delta": {
      "enum": [
        "none",
        "increase",
        "decrease",
        "unknown"
      ],
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "relative_time_sec",
    "actor_id",
    "source_surface",
    "source_index_family",
    "source_sourcetype_family",
    "action",
    "action_family",
    "object_type",
    "object_id",
    "status",
    "scenario_run_id",
    "raw_event_ref",
    "redaction_level"
  ],
  "title": "normalized_event_v1",
  "type": "object"
}
