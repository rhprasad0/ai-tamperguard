{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-tamperguard/schemas/model_artifact_v0.schema.json",
  "title": "AI TamperGuard v0 logistic regression model artifact",
  "type": "object",
  "required": [
    "model_version",
    "feature_order",
    "intercept",
    "coefficients",
    "threshold",
    "label_rule_id",
    "training_metadata",
    "score_envelope"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "model_version": {"type": "string", "minLength": 1},
    "model_type": {"type": "string"},
    "feature_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^feature_[A-Za-z0-9_]+$"}
    },
    "intercept": {"type": "number"},
    "coefficients": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "label_rule_id": {"type": "string", "minLength": 1},
    "training_metadata": {
      "type": "object",
      "required": ["python_version", "sklearn_version", "random_seed", "training_git_sha"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "sklearn_version": {"type": "string", "minLength": 1},
        "random_seed": {"type": "integer"},
        "training_git_sha": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "score_envelope": {
      "type": "object",
      "required": ["score_field", "probability_field", "prediction_field"],
      "properties": {
        "score_field": {"type": "string", "minLength": 1},
        "probability_field": {"type": "string", "minLength": 1},
        "prediction_field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
