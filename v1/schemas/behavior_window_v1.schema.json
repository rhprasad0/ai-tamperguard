{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^actor_[0-9]{3}$",
      "type": "string"
    },
    "feature_alert_modify_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_config_change_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_dashboard_modify_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_distinct_object_type_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_event_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_modify_then_requery_flag": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_permission_denied_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_saved_search_modify_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_search_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_search_then_modify_flag": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_visibility_object_read_count": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_visibility_object_write_count": {
      "minimum": 0,
      "type": "integer"
    },
    "label_binary": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "label_family": {
      "enum": [
        "benign_admin",
        "benign_investigation",
        "benign_visibility_change",
        "benign_alert_tuning",
        "suspicious_recon",
        "permission_probe",
        "evidence_laundering",
        "alert_suppression",
        "logging_degradation",
        "input_or_token_tamper",
        "role_or_capability_tamper",
        "routing_or_transform_tamper",
        "lookup_or_report_overwrite",
        "report_alibi_generation",
        "failed_tamper_attempt",
        "successful_synthetic_tamper",
        "background_unlabeled"
      ],
      "type": "string"
    },
    "label_source": {
      "enum": [
        "scenario_answer_key",
        "paired_benign_control",
        "manual_review",
        "heuristic_rule",
        "post_run_verification",
        "background_unlabeled",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "scenario_run_id": {
      "type": "string"
    },
    "split_id": {
      "minLength": 1,
      "type": "string"
    },
    "window_end_relative_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "window_id": {
      "pattern": "^window_[0-9]+_[0-9]{6}$",
      "type": "string"
    },
    "window_start_relative_sec": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "window_id",
    "scenario_run_id",
    "actor_id",
    "window_start_relative_sec",
    "window_end_relative_sec",
    "feature_event_count",
    "label_binary",
    "label_family",
    "label_source",
    "split_id"
  ],
  "title": "behavior_window_v1",
  "type": "object"
}
